# Copy to .env.local and fill from the central Terraform outputs.
# Local dev (`next dev`) with no API URL automatically uses in-memory demo data.
# To force demo data anywhere (e.g. a hosted demo), set NEXT_PUBLIC_USE_MOCK=true.
# NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_BASE_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_COGNITO_DOMAIN=cost-killer-auth-xxxx.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
